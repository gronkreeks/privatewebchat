// Windows resources: the app icon (Explorer, taskbar, window, tray) and version details.
// Built from the app folder: rc win\app.rc / windres win/app.rc
#include <winver.h>
1 ICON "icons/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,3,0
PRODUCTVERSION 1,1,3,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "privatewebchat"
      VALUE "FileDescription", "privatewebchat"
      VALUE "OriginalFilename", "privatewebchat.exe"
      VALUE "ProductVersion", "1.1.3"
      VALUE "FileVersion", "1.1.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
